# Embedding model: Hugging Face model ID or an absolute local path.
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_DEVICE=cpu

# Chroma persistence and collection.
RAG_PERSIST_DIR=data/chroma
RAG_COLLECTION_NAME=company_docs

# Local Ollama generation model.
RAG_MODEL=deepseek-r1:7b

# Retrieval configuration.
RAG_MAX_DISTANCE=0.90
RAG_VECTOR_TOP_K=8
RAG_BM25_TOP_K=8
RAG_RRF_RANK_CONSTANT=60

# Optional cross-encoder reranking.
RAG_ENABLE_RERANK=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-large
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_LOCAL_ONLY=true
RAG_RERANK_MIN_SCORE=0.45

# API and frontend.
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_API_URL=http://127.0.0.1:8000
